{
  "name": "FPGA Development",

  // Gold image: built from workspace-base, contains base OS + Go + decomk
  // + TOOLS + GO + PYTHON. Pulled directly; no features needed to bootstrap.
  "image": "ghcr.io/computerscienceiscool/workspace-base:block0-2026-04-12",

  "containerEnv": {
    "DECOMK_HOME": "/var/decomk",
    "DECOMK_LOG_DIR": "/var/log/decomk",
    "DECOMK_TOOL_MODE": "install",
    "DECOMK_TOOL_INSTALL_PKG": "github.com/stevegt/decomk/cmd/decomk@latest",
    "DECOMK_TOOL_REPO": "https://github.com/stevegt/decomk",
    "DECOMK_CONF_REPO": "https://github.com/ciwg/workspace-config",
    "DECOMK_RUN_ARGS": "all"
  },

  "postCreateCommand": "bash .devcontainer/postCreateCommand.sh",

  "forwardPorts": [],

  "customizations": {
    "vscode": {
      "extensions": [
        "mshr-h.veriloghdl",
        "lramseyer.vaporview",
        "surfer-project.surfer"
      ]
    }
  }
}
